# Copia este archivo a .env (está en .gitignore). Todo es opcional.

# Contraseña para entrar (HTTP Basic, cualquier usuario). Vacío = sin contraseña.
# Ponla SIEMPRE si publicas el puerto fuera de 127.0.0.1.
AUTH_PASSWORD=

# Pon 1 solo si estás detrás de un proxy de confianza (Cloudflare, Caddy, nginx):
# usa la IP real del visitante para los límites del modo demo.
TRUST_PROXY=

# Trabajos simultáneos y horas que un archivo listo sigue en el servidor
CONCURRENCY=3
OUTBOX_HOURS=24

# Metadatos extra desde Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 0 = no actualizar yt-dlp al arrancar (YouTube lo rompe seguido; se recomienda dejarlo activo)
YTDLP_AUTOUPDATE=1

# --- Solo para una instancia pública de demostración ---
# DEMO_MODE=1   apaga biblioteca, suscripciones, Telegram, ajustes y borrado de historial; activa límites
# DEMO_MAX_MINUTES=20  DEMO_MAX_LIST=10  DEMO_JOBS_PER_HOUR=20  DEMO_INFO_PER_HOUR=60  DEMO_MAX_PENDING=30
